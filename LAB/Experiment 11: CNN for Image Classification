        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.metrics import confusion_matrix\n",
        "import tensorflow as tf\n",
        "from tensorflow import keras\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "(X_full, y_full), (X_test_full, y_test_full) = keras.datasets.cifar10.load_data()\n",
        "class_names = ['airplane', 'automobile', 'bird', 'cat', 'deer', 'dog', 'frog', 'horse', 'ship', 'truck']\n",
        "\n",
        "X_full = X_full[:4000].astype('float32') / 255.0\n",
        "y_full = y_full[:4000].ravel()\n",
        "X_train, X_val = X_full[:3200], X_full[3200:]\n",
        "y_train, y_val = y_full[:3200], y_full[3200:]\n",
        "X_test = X_test_full[:800].astype('float32') / 255.0\n",
        "y_test = y_test_full[:800].ravel()\n",
        "\n",
        "inputs = keras.Input(shape=(32, 32, 3))\n",
        "c1 = keras.layers.Conv2D(16, (3, 3), activation='relu', padding='same', name='conv1')(inputs)\n",
        "p1 = keras.layers.MaxPooling2D((2, 2))(c1)\n",
        "c2 = keras.layers.Conv2D(32, (3, 3), activation='relu', padding='same')(p1)\n",
        "p2 = keras.layers.MaxPooling2D((2, 2))(c2)\n",
        "flat = keras.layers.Flatten()(p2)\n",
        "d1 = keras.layers.Dense(64, activation='relu')(flat)\n",
        "outputs = keras.layers.Dense(10, activation='softmax')(d1)\n",
        "\n",
        "cnn = keras.Model(inputs, outputs)\n",
        "cnn.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])\n",
        "hist = cnn.fit(X_train, y_train, validation_data=(X_val, y_val), epochs=12, batch_size=64, verbose=0)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "axes[0].plot(hist.history['accuracy'], label='Train'); axes[0].plot(hist.history['val_accuracy'], label='Val')\n",
        "axes[0].set_title(\"CNN Accuracy\"); axes[0].legend()\n",
        "axes[1].plot(hist.history['loss'], label='Train'); axes[1].plot(hist.history['val_loss'], label='Val')\n",
        "axes[1].set_title(\"CNN Loss\"); axes[1].legend()\n",
        "plt.show()\n",
        "\n",
        "y_pred = np.argmax(cnn.predict(X_test, verbose=0), axis=1)\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(confusion_matrix(y_test, y_pred), annot=True, fmt='d', cmap='Blues', xticklabels=class_names, yticklabels=class_names)\n",
        "plt.title(\"Confusion Matrix\")\n",
        "plt.show()\n",
        "\n",
        "mis_idx = np.where(y_pred != y_test)[0][:5]\n",
        "fig, axes = plt.subplots(1, 5, figsize=(12, 3))\n",
        "for ax, idx in zip(axes, mis_idx):\n",
        "    ax.imshow(X_test[idx])\n",
        "    ax.set_title(f\"True: {class_names[y_test[idx]]}\\nPred: {class_names[y_pred[idx]]}\", fontsize=9)\n",
        "    ax.axis('off')\n",
        "plt.suptitle(\"Sample Misclassifications\")\n",
        "plt.show()\n",
        "\n",
        "feat_extractor = keras.Model(inputs=cnn.input, outputs=cnn.get_layer('conv1').output)\n",
        "fmaps = feat_extractor.predict(X_test[:1], verbose=0)[0]\n",
        "fig, axes = plt.subplots(2, 4, figsize=(10, 5))\n",
        "for i, ax in enumerate(axes.ravel()):\n",
        "    ax.imshow(fmaps[:, :, i], cmap='viridis')\n",
        "    ax.set_title(f\"Filter {i+1}\")\n",
        "    ax.axis('off')\n",
        "plt.suptitle(\"First Conv Layer Feature Maps\")\n",
        "plt.show()"
      ]
