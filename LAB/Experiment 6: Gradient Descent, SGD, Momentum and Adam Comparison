      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "from tensorflow import keras\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "def grad_fn(w):\n",
        "    return np.array([w[0], 10.0 * w[1]])\n",
        "\n",
        "start = np.array([4.0, 1.5])\n",
        "steps, lr = 40, 0.15\n",
        "\n",
        "path_gd, w = [start.copy()], start.copy()\n",
        "for _ in range(steps):\n",
        "    w -= lr * grad_fn(w)\n",
        "    path_gd.append(w.copy())\n",
        "\n",
        "path_sgd, w = [start.copy()], start.copy()\n",
        "for _ in range(steps):\n",
        "    w -= lr * (grad_fn(w) + np.random.normal(0, 0.6, 2))\n",
        "    path_sgd.append(w.copy())\n",
        "\n",
        "path_mom, w, v = [start.copy()], start.copy(), np.zeros(2)\n",
        "for _ in range(steps):\n",
        "    v = 0.7 * v + lr * grad_fn(w)\n",
        "    w -= v\n",
        "    path_mom.append(w.copy())\n",
        "\n",
        "path_gd, path_sgd, path_mom = np.array(path_gd), np.array(path_sgd), np.array(path_mom)\n",
        "xg, yg = np.meshgrid(np.linspace(-4.5, 4.5, 100), np.linspace(-2, 2, 100))\n",
        "zg = 0.5 * xg**2 + 5.0 * yg**2\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.contour(xg, yg, zg, levels=20, cmap='Greys')\n",
        "plt.plot(path_gd[:, 0], path_gd[:, 1], 'o-', label='Batch GD')\n",
        "plt.plot(path_sgd[:, 0], path_sgd[:, 1], 's-', alpha=0.7, label='SGD')\n",
        "plt.plot(path_mom[:, 0], path_mom[:, 1], '^-', label='Momentum')\n",
        "plt.title(\"Optimiser Paths on 2D Loss Contour\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "X_del = np.random.randn(400, 4)\n",
        "y_del = 15 + 5*X_del[:, 0] + 8*X_del[:, 1] + 2*X_del[:, 2] - 3*X_del[:, 3] + np.random.normal(0, 1.5, 400)\n",
        "\n",
        "opts = {\n",
        "    'SGD (lr=0.01)': keras.optimizers.SGD(0.01),\n",
        "    'Momentum (lr=0.01)': keras.optimizers.SGD(0.01, momentum=0.9),\n",
        "    'Adam (lr=0.01)': keras.optimizers.Adam(0.01),\n",
        "    'SGD High LR (lr=0.5)': keras.optimizers.SGD(0.5)\n",
        "}\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "for name, opt in opts.items():\n",
        "    m = keras.Sequential([keras.layers.Dense(16, activation='relu', input_shape=(4,)), keras.layers.Dense(1)])\n",
        "    m.compile(optimizer=opt, loss='mse')\n",
        "    h = m.fit(X_del, y_del, epochs=35, batch_size=32, verbose=0)\n",
        "    plt.plot(np.clip(h.history['loss'], 0, 500), label=name, linewidth=2)\n",
        "\n",
        "plt.title(\"Loss vs Epochs Across Optimisers\")\n",
        "plt.xlabel(\"Epochs\")\n",
        "plt.ylabel(\"MSE Loss\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
      ],
