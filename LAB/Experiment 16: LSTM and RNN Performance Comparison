        "import time\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "import tensorflow as tf\n",
        "from tensorflow import keras\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "days = np.arange(730)\n",
        "orders = 1000 + 0.5*days + 200*np.sin(2*np.pi*days/7) + 300*np.sin(2*np.pi*days/365) + np.random.normal(0, 40, 730)\n",
        "scaler = MinMaxScaler()\n",
        "scaled = scaler.fit_transform(orders.reshape(-1, 1))\n",
        "\n",
        "X, y = [], []\n",
        "for i in range(len(scaled) - 30):\n",
        "    X.append(scaled[i:i+30])\n",
        "    y.append(scaled[i+30])\n",
        "X, y = np.array(X), np.array(y)\n",
        "split = int(0.8 * len(X))\n",
        "X_tr, X_te, y_tr, y_te = X[:split], X[split:], y[:split], y[split:]\n",
        "\n",
        "results = []\n",
        "preds_dict = {}\n",
        "\n",
        "for name, layer in [(\"SimpleRNN\", keras.layers.SimpleRNN(32, input_shape=(30, 1))),\n",
        "                    (\"LSTM\", keras.layers.LSTM(32, input_shape=(30, 1)))]:\n",
        "    model = keras.Sequential([layer, keras.layers.Dense(1)])\n",
        "    model.compile(optimizer='adam', loss='mse')\n",
        "    t0 = time.time()\n",
        "    hist = model.fit(X_tr, y_tr, validation_data=(X_te, y_te), epochs=20, batch_size=32, verbose=0)\n",
        "    elapsed = round(time.time() - t0, 2)\n",
        "\n",
        "    pred_inv = scaler.inverse_transform(model.predict(X_te, verbose=0))\n",
        "    actual_inv = scaler.inverse_transform(y_te)\n",
        "    preds_dict[name] = pred_inv\n",
        "\n",
        "    mae = mean_absolute_error(actual_inv, pred_inv)\n",
        "    rmse = np.sqrt(mean_squared_error(actual_inv, pred_inv))\n",
        "    mape = np.mean(np.abs((actual_inv - pred_inv) / actual_inv)) * 100\n",
        "    results.append({\n",
        "        'Model': name,\n",
        "        'Train Loss': round(hist.history['loss'][-1], 5),\n",
        "        'Val Loss': round(hist.history['val_loss'][-1], 5),\n",
        "        'MAE': round(mae, 2),\n",
        "        'RMSE': round(rmse, 2),\n",
        "        'MAPE (%)': round(mape, 2),\n",
        "        'Time (s)': elapsed\n",
        "    })\n",
        "\n",
        "print(pd.DataFrame(results).to_string(index=False))\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.plot(actual_inv, label='Actual Orders', color='black', linewidth=2)\n",
        "plt.plot(preds_dict['SimpleRNN'], label='SimpleRNN', linestyle='--')\n",
        "plt.plot(preds_dict['LSTM'], label='LSTM', linestyle='-.')\n",
        "plt.title(\"Daily Order Forecast: SimpleRNN vs LSTM\")\n",
        "plt.xlabel(\"Days\")\n",
        "plt.ylabel(\"Order Volume\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
