        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "print(\"PPCA Model: x = Wz + mu + eps, where z ~ N(0, I) and eps ~ N(0, sigma^2 I)\")\n",
        "\n",
        "N, D, K_true = 200, 8, 3\n",
        "Z_true = np.random.randn(N, K_true)\n",
        "W_true = np.random.randn(K_true, D) * 2.0\n",
        "mu_true = np.linspace(10, 50, D)\n",
        "sigma_true = 0.8\n",
        "X = Z_true @ W_true + mu_true + np.random.normal(0, sigma_true, (N, D))\n",
        "\n",
        "recon_errors, est_sigmas = [], []\n",
        "ks = range(1, D)\n",
        "for k in ks:\n",
        "    ppca = PCA(n_components=k, random_state=42).fit(X)\n",
        "    X_recon = ppca.inverse_transform(ppca.transform(X))\n",
        "    recon_errors.append(np.mean((X - X_recon) ** 2))\n",
        "    est_sigmas.append(ppca.noise_variance_)\n",
        "\n",
        "ppca_3 = PCA(n_components=3, random_state=42).fit(X)\n",
        "print(f\"True Noise Variance: {sigma_true**2:.4f} | Estimated Noise Variance (k=3): {ppca_3.noise_variance_:.4f}\")\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.plot(ks, recon_errors, 'o-', label='Reconstruction MSE')\n",
        "plt.plot(ks, est_sigmas, 's--', label='Estimated Noise Variance')\n",
        "plt.title(\"PPCA Reconstruction Error vs Component Count\")\n",
        "plt.xlabel(\"Latent Components (k)\"); plt.ylabel(\"MSE / Variance\"); plt.legend(); plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "Z_new = np.random.randn(5, 3)\n",
        "X_syn = ppca_3.inverse_transform(Z_new) + np.random.normal(0, np.sqrt(ppca_3.noise_variance_), (5, D))\n",
        "print(\"\\nGenerated Synthetic Sensor Samples (First 4 Sensors):\\n\", np.round(X_syn[:, :4], 2))"
      ]
