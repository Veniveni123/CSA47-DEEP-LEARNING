        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import make_moons\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "X, y = make_moons(n_samples=300, noise=0.18, random_state=42)\n",
        "y = y.reshape(-1, 1)\n",
        "\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-np.clip(z, -20, 20)))\n",
        "9\n",
        "def sigmoid_deriv(a):\n",
        "    return a * (1 - a)\n",
        "\n",
        "W1 = np.random.randn(2, 8) * 0.5\n",
        "b1 = np.zeros((1, 8))\n",
        "W2 = np.random.randn(8, 1) * 0.5\n",
        "b2 = np.zeros((1, 1))\n",
        "\n",
        "def forward(X_in, W1, b1, W2, b2):\n",
        "    z1 = X_in @ W1 + b1\n",
        "    a1 = sigmoid(z1)\n",
        "    z2 = a1 @ W2 + b2\n",
        "    a2 = sigmoid(z2)\n",
        "    return z1, a1, z2, a2\n",
        "\n",
        "def compute_loss(y_true, y_pred):\n",
        "    eps = 1e-8\n",
        "    return -np.mean(y_true * np.log(y_pred + eps) + (1 - y_true) * np.log(1 - y_pred + eps))\n",
        "\n",
        "_, _, _, a2_init = forward(X, W1, b1, W2, b2)\n",
        "dz2 = (a2_init - y) / len(X)\n",
        "dW1_analytical = (X.T @ ((dz2 @ W2.T) * sigmoid_deriv(sigmoid(X @ W1 + b1))))[0, 0]\n",
        "\n",
        "eps = 1e-5\n",
        "W1_p = W1.copy(); W1_p[0, 0] += eps\n",
        "W1_m = W1.copy(); W1_m[0, 0] -= eps\n",
        "dW1_numerical = (compute_loss(y, forward(X, W1_p, b1, W2, b2)[3]) - compute_loss(y, forward(X, W1_m, b1, W2, b2)[3])) / (2 * eps)\n",
        "print(f\"Gradient Check W1[0,0] -> Analytical: {dW1_analytical:.6f} | Numerical: {dW1_numerical:.6f}\")\n",
        "\n",
        "lr = 1.5\n",
        "losses = []\n",
        "for ep in range(1500):\n",
        "    z1, a1, z2, a2 = forward(X, W1, b1, W2, b2)\n",
        "    losses.append(compute_loss(y, a2))\n",
        "\n",
        "    dz2 = (a2 - y) / len(X)\n",
        "    dW2 = a1.T @ dz2\n",
        "    db2 = np.sum(dz2, axis=0, keepdims=True)\n",
        "\n",
        "    dz1 = (dz2 @ W2.T) * sigmoid_deriv(a1)\n",
        "    dW1 = X.T @ dz1\n",
        "    db1 = np.sum(dz1, axis=0, keepdims=True)\n",
        "\n",
        "    W2 -= lr * dW2; b2 -= lr * db2\n",
        "    W1 -= lr * dW1; b1 -= lr * db1\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
        "axes[0].plot(losses, linewidth=2)\n",
        "axes[0].set_title(\"Training Loss\")\n",
        "axes[0].set_xlabel(\"Epochs\")\n",
        "axes[0].set_ylabel(\"BCE Loss\")\n",
        "axes[0].grid(True)\n",
        "\n",
        "xx, yy = np.meshgrid(np.linspace(-1.5, 2.5, 150), np.linspace(-1.0, 1.5, 150))\n",
        "probs = forward(np.c_[xx.ravel(), yy.ravel()], W1, b1, W2, b2)[3].reshape(xx.shape)\n",
        "axes[1].contourf(xx, yy, probs, levels=20, cmap=\"RdBu\", alpha=0.7)\n",
        "axes[1].scatter(X[:, 0], X[:, 1], c=y.ravel(), cmap=\"RdBu\", edgecolors='k')\n",
        "axes[1].set_title(\"Non-Linear Decision Boundary\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
