        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# 1. Build Customer-Genre (6x5) and Genre-Book (5x4) matrices\n",
        "customers = ['C1', 'C2', 'C3', 'C4', 'C5', 'C6']\n",
        "genres = ['Sci-Fi', 'Romance', 'Thriller', 'Fantasy', 'History']\n",
        "books = ['Book_A', 'Book_B', 'Book_C', 'Book_D']\n",
        "\n",
        "C = np.random.randint(1, 6, size=(6, 5)).astype(float)\n",
        "B = np.random.uniform(0.1, 1.0, size=(5, 4)).round(2)\n",
        "\n",
        "# 2. Dot products, matrix product, transpose, inverse, element-wise ops\n",
        "scores = C @ B\n",
        "C_T = C.T\n",
        "square_sub = C[:4, :4] + np.eye(4) * 2\n",
        "inv_sub = np.linalg.inv(square_sub)\n",
        "elem_wise = C[:5, :4] * B\n",
        "\n",
        "print(\"Recommendation Score Matrix (6x4):\\n\", np.round(scores, 2))\n",
        "print(\"\\nDeterminant of 4x4 submatrix:\", round(np.linalg.det(square_sub), 2))\n",
        "print(\"Inverse check (A @ A_inv ≈ I):\\n\", np.round(square_sub @ inv_sub, 2))\n",
        "\n",
        "# 3. Cosine similarity between customers\n",
        "norms = np.linalg.norm(C, axis=1, keepdims=True)\n",
        "C_norm = C / norms\n",
        "cos_sim = C_norm @ C_norm.T\n",
        "\n",
        "np.fill_diagonal(cos_sim, -1)\n",
        "i, j = np.unravel_index(np.argmax(cos_sim), cos_sim.shape)\n",
        "print(f\"\\nMost similar customers: {customers[i]} & {customers[j]} (Cosine Sim = {cos_sim[i, j]:.4f})\")\n",
        "\n",
        "# 4. Dense layer y = Wx + b manually for Customer 1\n",
        "W = B.T\n",
        "x = C[0]\n",
        "b = np.array([0.5, -0.2, 0.1, 0.3])\n",
        "y_manual = np.dot(W, x) + b\n",
        "print(\"\\nManual Dense Layer Output (y = Wx + b) for C1:\", np.round(y_manual, 3))\n",
        "\n",
        "# 5. Visualise score matrix as heatmap\n",
        "plt.figure(figsize=(7, 5))\n",
        "sns.heatmap(scores, annot=True, fmt=\".2f\", cmap=\"YlGnBu\", xticklabels=books, yticklabels=customers)\n",
        "plt.title(\"Customer-Book Recommendation Scores\")\n",
        "plt.xlabel(\"Books\")\n",
        "plt.ylabel(\"Customers\")\n",
        "plt.show()"
      ]
