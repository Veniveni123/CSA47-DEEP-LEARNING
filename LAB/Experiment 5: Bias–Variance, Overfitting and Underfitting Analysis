        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import PolynomialFeatures\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "def true_fn(x):\n",
        "    return 20 + 0.05 * x + 15 * np.sin(x / 350)\n",
        "\n",
        "X = np.sort(np.random.uniform(500, 3000, 150))[:, np.newaxis]\n",
        "y = true_fn(X[:, 0]) + np.random.normal(0, 6, 150)\n",
        "X_train, X_val, y_train, y_val = train_test_split(X, y, test_size=0.3, random_state=42)\n",
        "\n",
        "degrees = [1, 3, 9, 15]\n",
        "X_grid = np.linspace(500, 3000, 300)[:, np.newaxis]\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.scatter(X_train, y_train, color='gray', alpha=0.5, label='Data')\n",
        "plt.plot(X_grid, true_fn(X_grid[:, 0]), 'k--', label='True Curve')\n",
        "for deg in degrees:\n",
        "    m = make_pipeline(PolynomialFeatures(deg), LinearRegression()).fit(X_train, y_train)\n",
        "    plt.plot(X_grid, m.predict(X_grid), label=f'Degree {deg}', linewidth=2)\n",
        "plt.ylim(0, 180)\n",
        "plt.title(\"Polynomial Fits Across Degrees\")\n",
        "plt.xlabel(\"Floor Area\")\n",
        "plt.ylabel(\"House Price\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "train_mse, val_mse = [], []\n",
        "for deg in range(1, 16):\n",
        "    m = make_pipeline(PolynomialFeatures(deg), LinearRegression()).fit(X_train, y_train)\n",
        "    train_mse.append(mean_squared_error(y_train, m.predict(X_train)))\n",
        "    val_mse.append(mean_squared_error(y_val, m.predict(X_val)))\n",
        "\n",
        "plt.figure(figsize=(8, 4))\n",
        "plt.plot(range(1, 16), train_mse, 'o-', label='Train Error')\n",
        "plt.plot(range(1, 16), val_mse, 's-', label='Validation Error')\n",
        "plt.yscale('log')\n",
        "plt.title(\"Error vs Model Complexity\")\n",
        "plt.xlabel(\"Polynomial Degree\")\n",
        "plt.ylabel(\"MSE\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "y_true_val = true_fn(X_val[:, 0])\n",
        "print(f\"{'Degree':<8} | {'Bias^2':<10} | {'Variance':<10} | {'Val MSE':<10}\")\n",
        "print(\"-\" * 46)\n",
        "for deg in degrees:\n",
        "    preds = []\n",
        "    for _ in range(100):\n",
        "        idx = np.random.choice(len(X_train), len(X_train), replace=True)\n",
        "        m = make_pipeline(PolynomialFeatures(deg), LinearRegression()).fit(X_train[idx], y_train[idx])\n",
        "        preds.append(m.predict(X_val))\n",
        "    preds = np.array(preds)\n",
        "    bias_sq = np.mean((np.mean(preds, axis=0) - y_true_val) ** 2)\n",
        "    var = np.mean(np.var(preds, axis=0))\n",
        "    mse = mean_squared_error(y_val, np.mean(preds, axis=0))\n",
        "    print(f\"{deg:<8} | {bias_sq:<10.2f} | {var:<10.2f} | {mse:<10.2f}\")\n",
        "\n",
        "print(\"\\nSelected Degree: 3 (Achieves minimum validation MSE with balanced bias and variance).\")"
      ]
