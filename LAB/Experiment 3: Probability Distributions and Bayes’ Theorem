        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import stats\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "fig, axes = plt.subplots(1, 5, figsize=(20, 4))\n",
        "\n",
        "s_bern = stats.bernoulli.rvs(0.7, size=1000)\n",
        "axes[0].hist(s_bern, bins=[-0.2, 0.2, 0.8, 1.2], density=True, alpha=0.6)\n",
        "axes[0].plot([0, 1], stats.bernoulli.pmf([0, 1], 0.7), 'ro')\n",
        "axes[0].set_title(\"Bernoulli\")\n",
        "\n",
        "s_binom = stats.binom.rvs(10, 0.5, size=1000)\n",
        "x_b = np.arange(0, 11)\n",
        "axes[1].hist(s_binom, bins=np.arange(12)-0.5, density=True, alpha=0.6)\n",
        "axes[1].plot(x_b, stats.binom.pmf(x_b, 10, 0.5), 'ro-')\n",
        "axes[1].set_title(\"Binomial\")\n",
        "\n",
        "s_pois = stats.poisson.rvs(4, size=1000)\n",
        "x_p = np.arange(0, 14)\n",
        "axes[2].hist(s_pois, bins=np.arange(15)-0.5, density=True, alpha=0.6)\n",
        "axes[2].plot(x_p, stats.poisson.pmf(x_p, 4), 'ro-')\n",
        "axes[2].set_title(\"Poisson\")\n",
        "\n",
        "s_uni = stats.uniform.rvs(0, 10, size=1000)\n",
        "x_u = np.linspace(0, 10, 100)\n",
        "axes[3].hist(s_uni, bins=20, density=True, alpha=0.6)\n",
        "axes[3].plot(x_u, stats.uniform.pdf(x_u, 0, 10), 'r-')\n",
        "axes[3].set_title(\"Uniform\")\n",
        "\n",
        "s_norm = stats.norm.rvs(50, 10, size=1000)\n",
        "x_n = np.linspace(15, 85, 100)\n",
        "axes[4].hist(s_norm, bins=25, density=True, alpha=0.6)\n",
        "axes[4].plot(x_n, stats.norm.pdf(x_n, 50, 10), 'r-')\n",
        "axes[4].set_title(\"Gaussian\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "prev, sens, spec = 0.01, 0.95, 0.90\n",
        "p_pos = sens * prev + (1 - spec) * (1 - prev)\n",
        "posterior = (sens * prev) / p_pos\n",
        "print(f\"Analytical P(Disease | Positive): {posterior:.4%}\")\n",
        "\n",
        "N = 100000\n",
        "disease = np.random.rand(N) < prev\n",
        "positive = np.where(disease, np.random.rand(N) < sens, np.random.rand(N) < (1 - spec))\n",
        "emp_prob = np.sum(disease & positive) / np.sum(positive)\n",
        "print(f\"Empirical P(Disease | Positive):  {emp_prob:.4%}\")\n",
        "\n",
        "prev_vals = np.linspace(0.001, 0.20, 200)\n",
        "post_vals = (sens * prev_vals) / (sens * prev_vals + (1 - spec) * (1 - prev_vals))\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.plot(prev_vals * 100, post_vals * 100, linewidth=2)\n",
        "plt.title(\"Posterior Probability vs Disease Prevalence\")\n",
        "plt.xlabel(\"Prevalence (%)\")\n",
        "plt.ylabel(\"P(Disease | Positive) (%)\")\n",
        "plt.grid(True)\n",
        "plt.show()"
      ]
    }
